# Copy to `.env` for local dev (`npm run dev`). On the server, set these as
# environment variables in Coolify instead — never commit the real `.env`.

# PostgreSQL connection string.
#   Local dev:      postgres://payload:password@localhost:5432/payload
#   Docker/compose: postgres://payload:<POSTGRES_PASSWORD>@postgres:5432/payload
DATABASE_URL=

# Long random string for signing auth tokens/cookies. Generate: openssl rand -base64 32
PAYLOAD_SECRET=

# Used only by docker-compose.yml (the ${...} placeholders). Set in Coolify on deploy.
POSTGRES_PASSWORD=