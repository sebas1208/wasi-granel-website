  "html": "<!DOCTYPE html>\n\n<html lang=\"es\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/><meta content=\"web_standard\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&amp;display=swap\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><style>@layer base{html,body{margin:0;padding:0;}body{overscroll-behavior:none;}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config={darkMode:\"class\",theme:{extend:{colors:{\"primary-container\":\"#fcbf00\",\"inverse-on-surface\":\"#ffeedd\",\"outline-variant\":\"#d3c5ab\",\"on-surface-variant\":\"#4f4632\",\"inverse-surface\":\"#3a2e21\",\"tertiary\":\"#695c50\",\"error\":\"#ba1a1a\",\"surface-container-lowest\":\"#ffffff\",\"on-tertiary-fixed-variant\":\"#50453a\",\"surface-container-highest\":\"#f3dfcb\",\"on-secondary-container\":\"#726155\",\"surface-container-low\":\"#fff1e5\",\"on-secondary-fixed-variant\":\"#534438\",\"surface-variant\":\"#f3dfcb\",\"on-background\":\"#241a0d\",\"on-secondary-fixed\":\"#251910\",\"surface\":\"#fff8f4\",\"on-error-container\":\"#93000a\",\"surface-dim\":\"#ead7c3\",\"surface-tint\":\"#785a00\",\"on-error\":\"#ffffff\",\"on-surface\":\"#241a0d\",\"tertiary-container\":\"#d7c6b7\",\"primary-fixed\":\"#ffdf9d\",\"tertiary-fixed\":\"#f1dfd0\",\"primary\":\"#785a00\",\"on-primary\":\"#ffffff\",\"outline\":\"#817660\",\"on-tertiary-fixed\":\"#231a11\",\"on-primary-fixed\":\"#251a00\",\"secondary-container\":\"#f5dece\",\"on-tertiary\":\"#ffffff\",\"on-secondary\":\"#ffffff\",\"secondary-fixed-dim\":\"#d8c3b3\",\"on-primary-fixed-variant\":\"#5b4300\",\"secondary\":\"#6c5b4f\",\"surface-container-high\":\"#f9e5d0\",\"on-tertiary-container\":\"#5e5246\",\"inverse-primary\":\"#fabd00\",\"surface-bright\":\"#fff8f4\",\"on-primary-container\":\"#6b4f00\",\"primary-fixed-dim\":\"#fabd00\",\"tertiary-fixed-dim\":\"#d4c4b5\",\"secondary-fixed\":\"#f5dece\",\"background\":\"#fff8f4\",\"surface-container\":\"#ffebd6\",\"error-container\":\"#ffdad6\"},borderRadius:{\"DEFAULT\":\"0.25rem\",\"lg\":\"0.5rem\",\"xl\":\"0.75rem\",\"full\":\"9999px\"},spacing:{},fontFamily:{headline:[\"Plus Jakarta Sans\"],display:[\"Plus Jakarta Sans\"],body:[\"Plus Jakarta Sans\"],label:[\"Plus Jakarta Sans\"]},fontSize:{}}}};</script></head><body class=\"bg-surface font-body text-on-surface min-h-screen flex flex-col\"><header class=\"fixed top-0 left-0 right-0 z-50 bg-surface/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]\"><div class=\"h-20 max-w-7xl mx-auto px-6 lg:px-12 flex items-center justify-between gap-8\"><div class=\"flex items-center gap-3 shrink-0\"><img alt=\"logo.png\" class=\"h-8 w-auto object-contain\" src=\"https://lh3.googleusercontent.com/aida/AEtjO1Un6K08koTes3j5eZfEV67pnSVVJ9hGHpglLARgFBwlcSa_JCLiPmXUcbfl4_0-xFXZ29nlpMZTky_9ch6cu_lORIIcG6XXzkd21VVqUrhPeck-Nbh00OEg8uVYTvgUcTGui_sLnAGWqjkTIl1i2JhnH1DfmfJ5RLihndd7HYModi_09fDuEYSNBOVVF7oaqmj3h8iu4pASCtnMVMsNR4Ww2QDf1OvyPwaZYTk9S6NRWWBhechBiA7pFGrDZRMCs5oAEaWItWPWVpA\"/><span class=\"font-headline font-bold text-xl tracking-tight text-on-surface\">Wasi Granel</span></div><nav class=\"hidden md:flex items-center gap-8\" data-active-classes=\"text-on-surface font-bold\"><a class=\"text-sm text-on-surface-variant hover:text-on-surface transition-colors font-medium\" data-path=\"inicio\" href=\"#\">Inicio</a><a aria-current=\"page\" class=\"transition-colors text-on-surface font-bold\" data-path=\"tienda\" href=\"#\">Tienda</a><a class=\"text-sm text-on-surface-variant hover:text-on-surface transition-colors font-medium\" data-path=\"contacto\" href=\"#\">Contacto</a></nav><div class=\"flex-1 max-w-md hidden sm:block\"><div class=\"relative flex items-center\"><span class=\"material-symbols-outlined absolute left-3.5 text-on-surface-variant text-[20px] pointer-events-none\">search</span><input class=\"w-full pl-10 pr-4 py-2 bg-surface-container-lowest text-on-surface placeholder:text-on-surface-variant text-sm rounded-lg border border-outline-variant focus:outline-none focus:border-on-surface transition-colors\" placeholder=\"Buscar...\" type=\"text\"/></div></div><div class=\"flex items-center gap-4 shrink-0\"><button aria-label=\"Ver carrito de compras\" class=\"relative p-2 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors\" type=\"button\"><span class=\"material-symbols-outlined text-[24px]\">shopping_bag</span><span class=\"absolute top-1 right-1 flex items-center justify-center min-w-[18px] h-[18px] px-1 text-[11px] font-bold bg-primary text-on-primary rounded-full\">3</span></button><div class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center\"><span class=\"material-symbols-outlined text-on-primary text-[18px]\">person</span></div></div></div></header><main class=\"w-full flex-1 pt-20 bg-surface\"><div class=\"max-w-7xl mx-auto px-6 lg:px-12 py-8\"><div class=\"flex flex-col w-full\">\n<div class=\"max-w-6xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-6 md:py-10\">\n<!-- Header Section -->\n<header class=\"mb-8 md:mb-12\">\n<div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary-container text-on-secondary-container text-xs font-bold tracking-wider uppercase mb-3\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-primary-container\"></span>\n        Compra al peso exacto\n      </div>\n<h1 class=\"font-headline font-bold text-3xl sm:text-4xl lg:text-5xl text-on-surface tracking-tight leading-tight\">\n        Finalizar pedido\n      </h1>\n<div class=\"mt-3 flex items-start sm:items-center gap-2.5 text-on-surface-variant text-sm sm:text-base max-w-2xl leading-relaxed\">\n<span class=\"material-symbols-outlined text-primary text-[20px] shrink-0 mt-0.5 sm:mt-0\">verified_user</span>\n<p>\n          No se realiza ningún pago en este sitio. Te escribimos por WhatsApp para confirmar el peso, el envío y el pago.\n        </p>\n</div>\n</header>\n<!-- Main Two-Column Grid -->\n<div class=\"grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start\">\n<!-- Left Column: Form (7/12) -->\n<section aria-labelledby=\"form-heading\" class=\"lg:col-span-7 flex flex-col gap-6\">\n<div class=\"bg-surface-container-lowest rounded-xl p-6 sm:p-8 shadow-sm\">\n<div class=\"flex items-center justify-between pb-5 border-b border-surface-container-high\">\n<h2 class=\"font-headline font-bold text-xl sm:text-2xl text-on-surface flex items-center gap-2.5\" id=\"form-heading\">\n<span class=\"w-7 h-7 rounded-lg bg-surface-container flex items-center justify-center text-xs font-bold text-on-surface\">1</span>\n              Tus datos\n            </h2>\n<span class=\"text-xs uppercase tracking-wider text-on-surface-variant font-medium\">Campos requeridos</span>\n</div>\n<form class=\"mt-6 flex flex-col gap-5\" id=\"checkout-form\" onsubmit=\"event.preventDefault(); handleFormSubmit();\">\n<!-- Campo 1: Nombre completo -->\n<div class=\"flex flex-col gap-1.5\">\n<label class=\"font-headline text-xs font-bold uppercase tracking-wider text-on-surface\" for=\"full-name\">\n                Nombre completo *\n              </label>\n<div class=\"relative\">\n<input class=\"w-full px-4 py-3 rounded-lg bg-surface-container-low text-on-surface placeholder:text-on-surface-variant/50 text-sm focus:outline-none focus:ring-2 focus:ring-primary-container transition-all\" id=\"full-name\" name=\"fullName\" placeholder=\"Ej. Camila Morales\" required=\"\" type=\"text\"/>\n</div>\n</div>\n<!-- Campo 2: Teléfono / WhatsApp -->\n<div class=\"flex flex-col gap-1.5\">\n<label class=\"font-headline text-xs font-bold uppercase tracking-wider text-on-surface\" for=\"phone-whatsapp\">\n                Teléfono / WhatsApp *\n              </label>\n<div class=\"relative\">\n<input class=\"w-full px-4 py-3 rounded-lg bg-surface-container-low text-on-surface placeholder:text-on-surface-variant/50 text-sm focus:outline-none focus:ring-2 focus:ring-primary-container transition-all\" id=\"phone-whatsapp\" name=\"phone\" placeholder=\"Ej. +593 9 9999 9999\" required=\"\" type=\"tel\"/>\n</div>\n<p class=\"text-xs text-on-surface-variant flex items-center gap-1.5 mt-0.5\">\n<span class=\"material-symbols-outlined text-[16px] text-primary\">chat</span>\n                Es por donde te confirmamos el pedido.\n              </p>\n</div>\n<!-- Campo 3: Dirección de entrega -->\n<div class=\"flex flex-col gap-1.5\">\n<label class=\"font-headline text-xs font-bold uppercase tracking-wider text-on-surface\" for=\"delivery-address\">\n                Dirección de entrega *\n              </label>\n<div class=\"relative\">\n<input class=\"w-full px-4 py-3 rounded-lg bg-surface-container-low text-on-surface placeholder:text-on-surface-variant/50 text-sm focus:outline-none focus:ring-2 focus:ring-primary-container transition-all\" id=\"delivery-address\" name=\"address\" placeholder=\"Calle, número, sector, ciudad\" required=\"\" type=\"text\"/>\n</div>\n</div>\n<!-- Campo 4: Zona de entrega -->\n<div class=\"flex flex-col gap-1.5\">\n<label class=\"font-headline text-xs font-bold uppercase tracking-wider text-on-surface\" for=\"delivery-zone\">\n                Zona de entrega *\n              </label>\n<div class=\"relative\">\n<select class=\"w-full px-4 py-3 rounded-lg bg-surface-container-low text-on-surface text-sm appearance-none focus:outline-none focus:ring-2 focus:ring-primary-container transition-all cursor-pointer pr-10\" id=\"delivery-zone\" name=\"deliveryZone\" onchange=\"updateShippingCallout(this.value)\">\n<option value=\"riobamba\">Riobamba (entrega gratis)</option>\n<option value=\"otra\">Otra ciudad (envío por Servientrega)</option>\n</select>\n<span class=\"material-symbols-outlined absolute right-3 top-3.5 pointer-events-none text-on-surface-variant text-[20px]\">\n                  keyboard_arrow_down\n                </span>\n</div>\n<!-- Callout informativo con ícono de camión -->\n<div class=\"mt-2.5 p-4 rounded-xl bg-surface-container-high text-on-surface flex items-start gap-3 transition-colors\" id=\"shipping-callout\">\n<div class=\"w-8 h-8 rounded-lg bg-primary-container text-on-primary-container flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-[20px]\">local_shipping</span>\n</div>\n<div class=\"text-xs sm:text-sm leading-relaxed\">\n<p class=\"text-on-surface\" id=\"shipping-callout-text\">\n                    El costo del envío se confirma contigo por WhatsApp antes de despachar. En Riobamba la entrega es gratis.\n                  </p>\n</div>\n</div>\n</div>\n<!-- Campo 5: Nota para el pedido (opcional) -->\n<div class=\"flex flex-col gap-1.5\">\n<label class=\"font-headline text-xs font-bold uppercase tracking-wider text-on-surface\" for=\"order-note\">\n                Nota para el pedido <span class=\"text-on-surface-variant font-normal lowercase\">(opcional)</span>\n</label>\n<textarea class=\"w-full px-4 py-3 rounded-lg bg-surface-container-low text-on-surface placeholder:text-on-surface-variant/50 text-sm focus:outline-none focus:ring-2 focus:ring-primary-container transition-all resize-y\" id=\"order-note\" name=\"orderNote\" placeholder=\"Ej. prefiero almendras sin sal, entregar después de las 15:00\" rows=\"3\"></textarea>\n</div>\n<!-- Checkboxes de consentimiento (ambas desmarcadas por defecto) -->\n<div class=\"mt-2 pt-5 border-t border-surface-container-high flex flex-col gap-3.5\">\n<label class=\"flex items-start gap-3 cursor-pointer group\">\n<input class=\"mt-1 w-4 h-4 rounded text-primary focus:ring-primary-container cursor-pointer accent-primary shrink-0\" id=\"consent-privacy\" name=\"consentPrivacy\" required=\"\" type=\"checkbox\"/>\n<span class=\"text-xs sm:text-sm text-on-surface-variant group-hover:text-on-surface transition-colors leading-snug\">\n                  Acepto el tratamiento de mis datos de contacto para gestionar mi pedido, según la Política de Privacidad de Wasi Granel.\n                </span>\n</label>\n<label class=\"flex items-start gap-3 cursor-pointer group\">\n<input class=\"mt-1 w-4 h-4 rounded text-primary focus:ring-primary-container cursor-pointer accent-primary shrink-0\" id=\"consent-whatsapp\" name=\"consentWhatsApp\" required=\"\" type=\"checkbox\"/>\n<span class=\"text-xs sm:text-sm text-on-surface-variant group-hover:text-on-surface transition-colors leading-snug\">\n                  Acepto recibir por WhatsApp la confirmación de mi pedido y los datos de pago.\n                </span>\n</label>\n</div>\n<!-- CTA Primario -->\n<div class=\"pt-4\">\n<button class=\"w-full py-4 rounded-xl bg-primary-container text-on-primary-container font-headline font-bold text-base shadow-sm hover:brightness-95 active:scale-[0.99] transition-all flex items-center justify-center gap-2\" type=\"submit\">\n<span>Confirmar pedido</span>\n<span class=\"material-symbols-outlined text-[20px]\">arrow_forward</span>\n</button>\n<a class=\"text-center text-sm text-on-surface-variant hover:text-on-surface hover:underline block mt-3.5 transition-colors font-medium\" href=\"#\">\n                Volver a la tienda\n              </a>\n</div>\n</form>\n</div>\n<!-- Trust Badges Under Form -->\n<div class=\"grid grid-cols-2 sm:grid-cols-3 gap-3\">\n<div class=\"p-3.5 rounded-lg bg-surface-container-low flex items-center gap-2.5\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">scale</span>\n<span class=\"text-xs font-medium text-on-surface\">Gramaje verificado</span>\n</div>\n<div class=\"p-3.5 rounded-lg bg-surface-container-low flex items-center gap-2.5\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">recycling</span>\n<span class=\"text-xs font-medium text-on-surface\">Envases reutilizables</span>\n</div>\n<div class=\"p-3.5 rounded-lg bg-surface-container-low flex items-center gap-2.5 col-span-2 sm:col-span-1\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">support_agent</span>\n<span class=\"text-xs font-medium text-on-surface\">Trato directo 1 a 1</span>\n</div>\n</div>\n</section>\n<!-- Right Column: Sticky Summary (5/12) -->\n<aside aria-label=\"Resumen de la orden\" class=\"lg:col-span-5 lg:sticky lg:top-28\">\n<div class=\"bg-surface-container-lowest rounded-xl p-6 sm:p-7 shadow-sm\">\n<!-- Summary Header -->\n<div class=\"flex items-center justify-between pb-5 border-b border-surface-container-high\">\n<div class=\"flex items-center gap-2.5\">\n<h2 class=\"font-headline font-bold text-xl text-on-surface\">Tu pedido</h2>\n<span class=\"px-2 py-0.5 rounded-full bg-secondary-container text-on-secondary-container text-xs font-bold\" id=\"cart-item-count-badge\">\n                3 productos\n              </span>\n</div>\n<span class=\"text-xs font-bold text-primary flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[16px]\">eco</span>\n              Zero Waste\n            </span>\n</div>\n<!-- Product Item Lines -->\n<div class=\"py-4 flex flex-col gap-4 divide-y divide-surface-container-high/60\">\n<!-- Línea 1: Mix de Frutos Secos -->\n<div class=\"pt-3 first:pt-0 flex flex-col gap-2.5\" data-item=\"1\" data-price=\"9.00\">\n<div class=\"flex justify-between items-start gap-2\">\n<div>\n<h3 class=\"font-headline font-bold text-sm text-on-surface leading-snug\">Mix de Frutos Secos</h3>\n<p class=\"text-xs text-on-surface-variant flex items-center gap-1 mt-0.5\">\n<span class=\"material-symbols-outlined text-[14px] text-tertiary\">inventory_2</span>\n                    500 g <span class=\"opacity-60\">•</span> frasco de vidrio retornable\n                  </p>\n</div>\n<span class=\"item-total-price font-headline font-bold text-sm text-on-surface shrink-0\">$9.00</span>\n</div>\n<div class=\"flex items-center justify-between mt-1\">\n<span class=\"text-xs text-on-surface-variant/80\">Unitario: $9.00</span>\n<div class=\"inline-flex items-center bg-surface-container-low rounded-lg p-0.5\">\n<button aria-label=\"Disminuir cantidad de Mix de Frutos Secos\" class=\"w-7 h-7 rounded-md flex items-center justify-center text-on-surface-variant hover:bg-surface-container hover:text-on-surface active:scale-95 transition-all\" onclick=\"changeQty(1, -1)\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px]\">remove</span>\n</button>\n<span class=\"w-8 text-center text-xs font-bold text-on-surface\" id=\"qty-1\">1</span>\n<button aria-label=\"Aumentar cantidad de Mix de Frutos Secos\" class=\"w-7 h-7 rounded-md flex items-center justify-center text-on-surface-variant hover:bg-surface-container hover:text-on-surface active:scale-95 transition-all\" onclick=\"changeQty(1, 1)\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px]\">add</span>\n</button>\n</div>\n</div>\n</div>\n<!-- Línea 2: Almendras Naturales -->\n<div class=\"pt-3 flex flex-col gap-2.5\" data-item=\"2\" data-price=\"7.60\">\n<div class=\"flex justify-between items-start gap-2\">\n<div>\n<h3 class=\"font-headline font-bold text-sm text-on-surface leading-snug\">Almendras Naturales</h3>\n<p class=\"text-xs text-on-surface-variant flex items-center gap-1 mt-0.5\">\n<span class=\"material-symbols-outlined text-[14px] text-tertiary\">shopping_bag</span>\n                    1 lb <span class=\"opacity-60\">•</span> bolsa kraft compostable\n                  </p>\n</div>\n<span class=\"item-total-price font-headline font-bold text-sm text-on-surface shrink-0\">$7.60</span>\n</div>\n<div class=\"flex items-center justify-between mt-1\">\n<span class=\"text-xs text-on-surface-variant/80\">Unitario: $7.60</span>\n<div class=\"inline-flex items-center bg-surface-container-low rounded-lg p-0.5\">\n<button aria-label=\"Disminuir cantidad de Almendras Naturales\" class=\"w-7 h-7 rounded-md flex items-center justify-center text-on-surface-variant hover:bg-surface-container hover:text-on-surface active:scale-95 transition-all\" onclick=\"changeQty(2, -1)\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px]\">remove</span>\n</button>\n<span class=\"w-8 text-center text-xs font-bold text-on-surface\" id=\"qty-2\">1</span>\n<button aria-label=\"Aumentar cantidad de Almendras Naturales\" class=\"w-7 h-7 rounded-md flex items-center justify-center text-on-surface-variant hover:bg-surface-container hover:text-on-surface active:scale-95 transition-all\" onclick=\"changeQty(2, 1)\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px]\">add</span>\n</button>\n</div>\n</div>\n</div>\n<!-- Línea 3: Trufas de Cacao Puro 70% -->\n<div class=\"pt-3 flex flex-col gap-2.5\" data-item=\"3\" data-price=\"5.20\">\n<div class=\"flex justify-between items-start gap-2\">\n<div>\n<h3 class=\"font-headline font-bold text-sm text-on-surface leading-snug\">Trufas de Cacao Puro 70%</h3>\n<p class=\"text-xs text-on-surface-variant flex items-center gap-1 mt-0.5\">\n<span class=\"material-symbols-outlined text-[14px] text-tertiary\">inventory_2</span>\n                    250 g <span class=\"opacity-60\">•</span> caja reutilizable\n                  </p>\n</div>\n<span class=\"item-total-price font-headline font-bold text-sm text-on-surface shrink-0\">$5.20</span>\n</div>\n<div class=\"flex items-center justify-between mt-1\">\n<span class=\"text-xs text-on-surface-variant/80\">Unitario: $5.20</span>\n<div class=\"inline-flex items-center bg-surface-container-low rounded-lg p-0.5\">\n<button aria-label=\"Disminuir cantidad de Trufas de Cacao Puro\" class=\"w-7 h-7 rounded-md flex items-center justify-center text-on-surface-variant hover:bg-surface-container hover:text-on-surface active:scale-95 transition-all\" onclick=\"changeQty(3, -1)\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px]\">remove</span>\n</button>\n<span class=\"w-8 text-center text-xs font-bold text-on-surface\" id=\"qty-3\">1</span>\n<button aria-label=\"Aumentar cantidad de Trufas de Cacao Puro\" class=\"w-7 h-7 rounded-md flex items-center justify-center text-on-surface-variant hover:bg-surface-container hover:text-on-surface active:scale-95 transition-all\" onclick=\"changeQty(3, 1)\" type=\"button\">\n<span class=\"material-symbols-outlined text-[16px]\">add</span>\n</button>\n</div>\n</div>\n</div>\n</div>\n<!-- Totals Breakdown -->\n<div class=\"pt-4 border-t border-surface-container-high flex flex-col gap-2.5\">\n<div class=\"flex justify-between items-center text-sm\">\n<span class=\"text-on-surface-variant\">Subtotal</span>\n<span class=\"font-medium text-on-surface\" id=\"summary-subtotal\">$21.80</span>\n</div>\n<div class=\"flex justify-between items-center text-sm\">\n<div class=\"flex items-center gap-1.5 text-on-surface-variant\">\n<span>Envases retornables</span>\n<span class=\"material-symbols-outlined text-[16px] text-tertiary\" title=\"Garantía reembolsable al devolver tu frasco\">info</span>\n</div>\n<span class=\"font-medium text-on-surface\">$1.00</span>\n</div>\n<div class=\"flex justify-between items-center text-sm\">\n<span class=\"text-on-surface-variant\">Envío estimado</span>\n<span class=\"font-medium text-primary\" id=\"shipping-rate-label\">Gratis en Riobamba</span>\n</div>\n<!-- Total Final Estimado -->\n<div class=\"pt-3 mt-1 border-t border-surface-container-high flex justify-between items-baseline\">\n<div>\n<span class=\"font-headline font-bold text-base text-on-surface block\">Total estimado</span>\n<span class=\"text-[11px] text-on-surface-variant\">Sujeto al peso exacto en balanza</span>\n</div>\n<span class=\"font-headline font-bold text-2xl text-on-surface tracking-tight\" id=\"summary-grand-total\">\n                $22.80\n              </span>\n</div>\n<p class=\"text-xs text-on-surface-variant leading-relaxed pt-1\">\n              El peso final y el valor exacto se confirman al despachar.\n            </p>\n</div>\n<!-- Conscious Trust Micro-banner -->\n<div class=\"mt-5 p-3.5 rounded-lg bg-surface-container-low flex items-center gap-3\">\n<div class=\"w-8 h-8 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-[18px]\">nature</span>\n</div>\n<div>\n<p class=\"font-headline font-bold text-xs text-on-surface\">Zero Waste &amp; Empaque Consciente</p>\n<p class=\"text-[11px] text-on-surface-variant\">Ahorras plástico de un solo uso en cada entrega.</p>\n</div>\n</div>\n</div>\n</aside>\n</div>\n</div>\n</div>\n<script>\n  const cartItems = {\n    1: { price: 9.00, qty: 1 },\n    2: { price: 7.60, qty: 1 },\n    3: { price: 5.20, qty: 1 }\n  };\n  const jarDeposit = 1.00;\n\n  function updateShippingCallout(zone) {\n    const calloutText = document.getElementById('shipping-callout-text');\n    const shippingLabel = document.getElementById('shipping-rate-label');\n    \n    if (zone === 'riobamba') {\n      calloutText.textContent = 'El costo del envío se confirma contigo por WhatsApp antes de despachar. En Riobamba la entrega es gratis.';\n      shippingLabel.textContent = 'Gratis en Riobamba';\n      shippingLabel.className = 'font-medium text-primary';\n    } else {\n      calloutText.textContent = 'Para envíos fuera de Riobamba despachamos por Servientrega. El valor exacto según peso y destino te lo informamos vía WhatsApp.';\n      shippingLabel.textContent = 'A confirmar vía Servientrega';\n      shippingLabel.className = 'font-medium text-on-surface';\n    }\n    calculateTotals();\n  }\n\n  function changeQty(id, delta) {\n    if (!cartItems[id]) return;\n    const newQty = cartItems[id].qty + delta;\n    if (newQty < 1) return; // Mantiene al menos 1 producto\n    \n    cartItems[id].qty = newQty;\n    document.getElementById(`qty-${id}`).textContent = newQty;\n    \n    // Actualizar total por línea\n    const itemContainer = document.querySelector(`[data-item=\"${id}\"]`);\n    if (itemContainer) {\n      const lineTotalSpan = itemContainer.querySelector('.item-total-price');\n      const lineTotal = cartItems[id].price * newQty;\n      lineTotalSpan.textContent = `$${lineTotal.toFixed(2)}`;\n    }\n\n    calculateTotals();\n  }\n\n  function calculateTotals() {\n    let subtotal = 0;\n    let totalItems = 0;\n\n    for (const key in cartItems) {\n      subtotal += cartItems[key].price * cartItems[key].qty;\n      totalItems += cartItems[key].qty;\n    }\n\n    const grandTotal = subtotal + jarDeposit;\n\n    document.getElementById('summary-subtotal').textContent = `$${subtotal.toFixed(2)}`;\n    document.getElementById('summary-grand-total').textContent = `$${grandTotal.toFixed(2)}`;\n    \n    const countBadge = document.getElementById('cart-item-count-badge');\n    countBadge.textContent = `${totalItems} ${totalItems === 1 ? 'producto' : 'productos'}`;\n  }\n\n  function handleFormSubmit() {\n    const name = document.getElementById('full-name').value.trim();\n    const phone = document.getElementById('phone-whatsapp').value.trim();\n    const zone = document.getElementById('delivery-zone').options[document.getElementById('delivery-zone').selectedIndex].text;\n    const consentWhatsapp = document.getElementById('consent-whatsapp').checked;\n    const consentPrivacy = document.getElementById('consent-privacy').checked;\n\n    if (!consentPrivacy || !consentWhatsapp) {\n      alert('Por favor, acepta los términos de contacto y confirmación por WhatsApp para continuar.');\n      return;\n    }\n\n    // Modal / mensaje visual amigable\n    const button = document.querySelector('#checkout-form button[type=\"submit\"]');\n    const originalText = button.innerHTML;\n    button.disabled = true;\n    button.innerHTML = '<span class=\"material-symbols-outlined animate-spin text-[20px]\">sync</span> Procesando pedido...';\n\n    setTimeout(() => {\n      button.innerHTML = '<span class=\"material-symbols-outlined text-[20px]\">check_circle</span> ¡Pedido Registrado!';\n      button.classList.remove('bg-primary-container', 'text-on-primary-container');\n      button.classList.add('bg-surface-container-high', 'text-on-surface');\n      \n      alert(`¡Gracias ${name}! Hemos registrado tu solicitud. Te escribiremos muy pronto a ${phone} para validar el pesaje final y despachar hacia ${zone}.`);\n      button.disabled = false;\n      button.innerHTML = originalText;\n    }, 1000);\n  }\n</script></div></main><footer class=\"w-full bg-primary-container text-on-primary-container mt-auto\"><div class=\"max-w-7xl mx-auto px-6 lg:px-12 pt-16 pb-12\"><div class=\"grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-on-primary-container/20\"><div class=\"space-y-4\"><div class=\"flex items-center gap-3\"><img alt=\"logo.png\" class=\"h-8 w-auto object-contain brightness-0\" src=\"https://lh3.googleusercontent.com/aida/AEtjO1Un6K08koTes3j5eZfEV67pnSVVJ9hGHpglLARgFBwlcSa_JCLiPmXUcbfl4_0-xFXZ29nlpMZTky_9ch6cu_lORIIcG6XXzkd21VVqUrhPeck-Nbh00OEg8uVYTvgUcTGui_sLnAGWqjkTIl1i2JhnH1DfmfJ5RLihndd7HYModi_09fDuEYSNBOVVF7oaqmj3h8iu4pASCtnMVMsNR4Ww2QDf1OvyPwaZYTk9S6NRWWBhechBiA7pFGrDZRMCs5oAEaWItWPWVpA\"/><span class=\"font-headline font-bold text-xl tracking-tight text-on-primary-container\">Wasi Granel</span></div><p class=\"text-sm text-on-primary-container leading-relaxed\">Consumo consciente, compras a granel y bienestar sostenible para tu hogar en armonía urbana.</p></div><div><h3 class=\"font-headline font-bold text-sm uppercase tracking-wider text-on-primary-container mb-4\">Navegación</h3><ul class=\"space-y-2.5 text-sm\"><li class=\"font-medium\"><a class=\"hover:underline\" href=\"#\">Inicio</a></li><li class=\"font-medium\"><a class=\"hove