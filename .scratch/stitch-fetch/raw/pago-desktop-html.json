  "html": "<!DOCTYPE html>\n\n<html lang=\"es\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/><meta content=\"web_standard\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&amp;display=swap\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><style>@layer base{html,body{margin:0;padding:0;}body{overscroll-behavior:none;}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config={darkMode:\"class\",theme:{extend:{colors:{\"primary-container\":\"#fcbf00\",\"inverse-on-surface\":\"#ffeedd\",\"outline-variant\":\"#d3c5ab\",\"on-surface-variant\":\"#4f4632\",\"inverse-surface\":\"#3a2e21\",\"tertiary\":\"#695c50\",\"error\":\"#ba1a1a\",\"surface-container-lowest\":\"#ffffff\",\"on-tertiary-fixed-variant\":\"#50453a\",\"surface-container-highest\":\"#f3dfcb\",\"on-secondary-container\":\"#726155\",\"surface-container-low\":\"#fff1e5\",\"on-secondary-fixed-variant\":\"#534438\",\"surface-variant\":\"#f3dfcb\",\"on-background\":\"#241a0d\",\"on-secondary-fixed\":\"#251910\",\"surface\":\"#fff8f4\",\"on-error-container\":\"#93000a\",\"surface-dim\":\"#ead7c3\",\"surface-tint\":\"#785a00\",\"on-error\":\"#ffffff\",\"on-surface\":\"#241a0d\",\"tertiary-container\":\"#d7c6b7\",\"primary-fixed\":\"#ffdf9d\",\"tertiary-fixed\":\"#f1dfd0\",\"primary\":\"#785a00\",\"on-primary\":\"#ffffff\",\"outline\":\"#817660\",\"on-tertiary-fixed\":\"#231a11\",\"on-primary-fixed\":\"#251a00\",\"secondary-container\":\"#f5dece\",\"on-tertiary\":\"#ffffff\",\"on-secondary\":\"#ffffff\",\"secondary-fixed-dim\":\"#d8c3b3\",\"on-primary-fixed-variant\":\"#5b4300\",\"secondary\":\"#6c5b4f\",\"surface-container-high\":\"#f9e5d0\",\"on-tertiary-container\":\"#5e5246\",\"inverse-primary\":\"#fabd00\",\"surface-bright\":\"#fff8f4\",\"on-primary-container\":\"#6b4f00\",\"primary-fixed-dim\":\"#fabd00\",\"tertiary-fixed-dim\":\"#d4c4b5\",\"secondary-fixed\":\"#f5dece\",\"background\":\"#fff8f4\",\"surface-container\":\"#ffebd6\",\"error-container\":\"#ffdad6\"},borderRadius:{\"DEFAULT\":\"0.25rem\",\"lg\":\"0.5rem\",\"xl\":\"0.75rem\",\"full\":\"9999px\"},spacing:{},fontFamily:{headline:[\"Plus Jakarta Sans\"],display:[\"Plus Jakarta Sans\"],body:[\"Plus Jakarta Sans\"],label:[\"Plus Jakarta Sans\"]},fontSize:{}}}};</script></head><body class=\"bg-surface font-body text-on-surface min-h-screen flex flex-col\"><header class=\"fixed top-0 left-0 right-0 z-50 bg-surface/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]\"><div class=\"h-20 max-w-7xl mx-auto px-6 lg:px-12 flex items-center justify-between gap-8\"><div class=\"flex items-center gap-3 shrink-0\"><img alt=\"logo.png\" class=\"h-8 w-auto object-contain\" src=\"https://lh3.googleusercontent.com/aida/AEtjO1Un6K08koTes3j5eZfEV67pnSVVJ9hGHpglLARgFBwlcSa_JCLiPmXUcbfl4_0-xFXZ29nlpMZTky_9ch6cu_lORIIcG6XXzkd21VVqUrhPeck-Nbh00OEg8uVYTvgUcTGui_sLnAGWqjkTIl1i2JhnH1DfmfJ5RLihndd7HYModi_09fDuEYSNBOVVF7oaqmj3h8iu4pASCtnMVMsNR4Ww2QDf1OvyPwaZYTk9S6NRWWBhechBiA7pFGrDZRMCs5oAEaWItWPWVpA\"/><span class=\"font-headline font-bold text-xl tracking-tight text-on-surface\">Wasi Granel</span></div><nav class=\"hidden md:flex items-center gap-8\" data-active-classes=\"text-on-surface font-bold\"><a class=\"text-sm text-on-surface-variant hover:text-on-surface transition-colors font-medium\" data-path=\"inicio\" href=\"#\">Inicio</a><a class=\"text-sm text-on-surface-variant hover:text-on-surface transition-colors font-medium\" data-path=\"tienda\" href=\"#\">Tienda</a><a class=\"text-sm text-on-surface-variant hover:text-on-surface transition-colors font-medium\" data-path=\"contacto\" href=\"#\">Contacto</a></nav><div class=\"flex-1 max-w-md hidden sm:block\"><div class=\"relative flex items-center\"><span class=\"material-symbols-outlined absolute left-3.5 text-on-surface-variant text-[20px] pointer-events-none\">search</span><input class=\"w-full pl-10 pr-4 py-2 bg-surface-container-lowest text-on-surface placeholder:text-on-surface-variant text-sm rounded-lg border border-outline-variant focus:outline-none focus:border-on-surface transition-colors\" placeholder=\"Buscar...\" type=\"text\"/></div></div><div class=\"flex items-center gap-4 shrink-0\"><button aria-label=\"Ver carrito de compras\" class=\"relative p-2 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors\" type=\"button\"><span class=\"material-symbols-outlined text-[24px]\">shopping_bag</span><span class=\"absolute top-1 right-1 flex items-center justify-center min-w-[18px] h-[18px] px-1 text-[11px] font-bold bg-primary text-on-primary rounded-full\">3</span></button><div class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center\"><span class=\"material-symbols-outlined text-on-primary text-[18px]\">person</span></div></div></div></header><main class=\"w-full flex-1 pt-20 bg-surface\"><div class=\"flex flex-col w-full\">\n<div class=\"w-full max-w-5xl mx-auto px-6 lg:px-8 py-10\">\n<!-- Breadcrumb & Back Affordance -->\n<nav aria-label=\"Navegación secundaria\" class=\"flex items-center gap-2 mb-8 text-xs font-semibold tracking-wide uppercase text-on-surface-variant\">\n<a class=\"inline-flex items-center gap-1.5 hover:text-on-surface transition-colors py-1\" href=\"#\">\n<span class=\"material-symbols-outlined text-[16px]\">arrow_back</span>\n<span>Volver a la confirmación de pedido</span>\n</a>\n<span class=\"text-outline-variant\">/</span>\n<span class=\"text-tertiary\">Instrucciones de pago</span>\n</nav>\n<!-- Header Section -->\n<div class=\"flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-outline-variant/30\">\n<div class=\"max-w-2xl space-y-3\">\n<div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-container-low text-on-surface-variant text-[11px] font-bold tracking-widest uppercase\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-primary-container\"></span>\n<span>Pago Seguro y Consciente</span>\n</div>\n<h1 class=\"font-headline font-bold text-3xl sm:text-4xl text-on-surface tracking-tight leading-tight\">\n          Cómo pagar tu pedido\n        </h1>\n<p class=\"text-base text-on-surface-variant leading-relaxed\">\n          Elige la opción que mejor se adapte a tu ritmo. Luego envíanos el comprobante vía WhatsApp para iniciar inmediatamente el pesado artesanal en empaques biodegradables.\n        </p>\n</div>\n<!-- Order Reference Card -->\n<div class=\"bg-surface-container-lowest p-4 rounded-xl shadow-sm flex flex-col sm:flex-row md:flex-col items-start sm:items-center md:items-start justify-between gap-3 shrink-0\">\n<div>\n<span class=\"text-[10px] uppercase font-bold tracking-widest text-on-surface-variant/80 block\">Pedido Asociado</span>\n<span class=\"font-headline text-lg font-bold text-on-surface tracking-wide\" id=\"orderNumber\">WG-2026-0001</span>\n</div>\n<button class=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface text-xs font-semibold transition-colors w-full justify-center\" id=\"btnCopyOrder\" onclick=\"copyToClipboard('WG-2026-0001', 'btnCopyOrderText', 'btnCopyOrderIcon')\" title=\"Copiar código de pedido\">\n<span class=\"material-symbols-outlined text-[16px]\" id=\"btnCopyOrderIcon\">content_copy</span>\n<span id=\"btnCopyOrderText\">Copiar código</span>\n</button>\n</div>\n</div>\n<!-- Dual Payment Method Grid -->\n<div class=\"grid grid-cols-1 lg:grid-cols-2 gap-8 my-10\">\n<!-- Option 1: DeUna Instant Pay -->\n<div class=\"bg-surface-container-lowest rounded-2xl p-7 flex flex-col justify-between shadow-sm relative overflow-hidden\">\n<div class=\"space-y-6\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-3\">\n<div class=\"w-10 h-10 rounded-xl bg-primary-container/20 flex items-center justify-center text-primary\">\n<span class=\"material-symbols-outlined text-[24px]\">qr_code_scanner</span>\n</div>\n<div>\n<h2 class=\"font-headline font-bold text-xl text-on-surface\">DeUna</h2>\n<p class=\"text-xs text-on-surface-variant font-medium\">Pago móvil instantáneo</p>\n</div>\n</div>\n<span class=\"px-2.5 py-1 rounded-full bg-surface-container text-on-surface-variant text-[11px] font-bold tracking-wider uppercase\">\n              Instantáneo\n            </span>\n</div>\n<p class=\"text-sm text-on-surface-variant leading-relaxed\">\n            Escanea directamente con la app de DeUna o la app de Banco Pichincha desde tu smartphone sin necesidad de registrar cuentas adicionales.\n          </p>\n<!-- QR Code Container -->\n<div class=\"flex flex-col items-center justify-center p-6 rounded-xl bg-surface-container-low\">\n<div class=\"w-48 h-48 rounded-xl bg-surface-container-lowest p-3 flex flex-col items-center justify-center shadow-inner relative group\">\n<!-- Visual Mock QR using high contrast geometric grid -->\n<svg class=\"w-full h-full text-on-surface\" fill=\"currentColor\" viewbox=\"0 0 100 100\">\n<!-- Top-Left Target -->\n<rect fill=\"none\" height=\"28\" rx=\"4\" stroke=\"currentColor\" stroke-width=\"4\" width=\"28\" x=\"5\" y=\"5\"></rect>\n<rect height=\"16\" rx=\"2\" width=\"16\" x=\"11\" y=\"11\"></rect>\n<!-- Top-Right Target -->\n<rect fill=\"none\" height=\"28\" rx=\"4\" stroke=\"currentColor\" stroke-width=\"4\" width=\"28\" x=\"67\" y=\"5\"></rect>\n<rect height=\"16\" rx=\"2\" width=\"16\" x=\"73\" y=\"11\"></rect>\n<!-- Bottom-Left Target -->\n<rect fill=\"none\" height=\"28\" rx=\"4\" stroke=\"currentColor\" stroke-width=\"4\" width=\"28\" x=\"5\" y=\"67\"></rect>\n<rect height=\"16\" rx=\"2\" width=\"16\" x=\"11\" y=\"73\"></rect>\n<!-- Abstract Data Pixels representing DeUna -->\n<rect height=\"8\" rx=\"1\" width=\"8\" x=\"38\" y=\"8\"></rect>\n<rect height=\"6\" rx=\"1\" width=\"6\" x=\"50\" y=\"8\"></rect>\n<rect height=\"12\" rx=\"1\" width=\"6\" x=\"38\" y=\"22\"></rect>\n<rect height=\"8\" rx=\"1\" width=\"8\" x=\"48\" y=\"20\"></rect>\n<rect height=\"12\" rx=\"1\" width=\"6\" x=\"8\" y=\"38\"></rect>\n<rect height=\"8\" rx=\"1\" width=\"8\" x=\"18\" y=\"44\"></rect>\n<rect height=\"6\" rx=\"1\" width=\"12\" x=\"8\" y=\"54\"></rect>\n<rect class=\"text-primary-container\" fill=\"currentColor\" height=\"24\" rx=\"4\" width=\"24\" x=\"38\" y=\"38\"></rect>\n<rect height=\"6\" rx=\"1\" width=\"10\" x=\"68\" y=\"38\"></rect>\n<rect height=\"12\" rx=\"1\" width=\"10\" x=\"82\" y=\"42\"></rect>\n<rect height=\"8\" rx=\"1\" width=\"8\" x=\"72\" y=\"50\"></rect>\n<rect height=\"10\" rx=\"1\" width=\"8\" x=\"38\" y=\"68\"></rect>\n<rect height=\"6\" rx=\"1\" width=\"14\" x=\"48\" y=\"74\"></rect>\n<rect height=\"8\" rx=\"1\" width=\"16\" x=\"42\" y=\"84\"></rect>\n<rect height=\"8\" rx=\"1\" width=\"14\" x=\"68\" y=\"68\"></rect>\n<rect height=\"12\" rx=\"1\" width=\"8\" x=\"86\" y=\"80\"></rect>\n<rect height=\"10\" rx=\"1\" width=\"12\" x=\"68\" y=\"82\"></rect>\n</svg>\n<!-- Center Badge Overlay -->\n<div class=\"absolute inset-0 flex items-center justify-center pointer-events-none\">\n<span class=\"w-8 h-8 rounded-full bg-primary-container flex items-center justify-center shadow-md\">\n<span class=\"material-symbols-outlined text-on-primary-container text-[18px]\">payments</span>\n</span>\n</div>\n</div>\n<span class=\"text-xs font-semibold text-on-surface mt-3\">Código QR Oficial · Wasi Granel</span>\n<span class=\"text-[11px] text-on-surface-variant text-center mt-0.5\">Escanea con Banco Pichincha o App DeUna</span>\n</div>\n<div class=\"space-y-2\">\n<div class=\"flex items-start gap-2.5 text-xs text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[18px] text-primary shrink-0 mt-0.5\">check_circle</span>\n<span>Acreditación en tiempo real sin recargos adicionales.</span>\n</div>\n<div class=\"flex items-start gap-2.5 text-xs text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[18px] text-primary shrink-0 mt-0.5\">lock</span>\n<span>Canal cifrado y validado por la red interbancaria nacional.</span>\n</div>\n</div>\n</div>\n<div class=\"pt-6 mt-6 border-t border-outline-variant/20 flex items-center justify-between text-xs text-on-surface-variant font-medium\">\n<span>Tiempo de confirmación:</span>\n<span class=\"font-bold text-on-surface\">Menos de 2 minutos</span>\n</div>\n</div>\n<!-- Option 2: Bank Transfer -->\n<div class=\"bg-surface-container-lowest rounded-2xl p-7 flex flex-col justify-between shadow-sm relative overflow-hidden\">\n<div class=\"space-y-6\">\n<div class=\"flex items-center justify-between\">\n<div class=\"flex items-center gap-3\">\n<div class=\"w-10 h-10 rounded-xl bg-surface-container flex items-center justify-center text-on-surface\">\n<span class=\"material-symbols-outlined text-[24px]\">account_balance</span>\n</div>\n<div>\n<h2 class=\"font-headline font-bold text-xl text-on-surface\">Transferencia Bancaria</h2>\n<p class=\"text-xs text-on-surface-variant font-medium\">Directa o Interbancaria</p>\n</div>\n</div>\n<span class=\"px-2.5 py-1 rounded-full bg-surface-container text-on-surface-variant text-[11px] font-bold tracking-wider uppercase\">\n              Nacional\n            </span>\n</div>\n<!-- Structured Banking Data Rows -->\n<div class=\"space-y-3 bg-surface-container-low rounded-xl p-4\">\n<!-- Row: Bank -->\n<div class=\"flex items-center justify-between py-2 border-b border-outline-variant/20 text-xs\">\n<span class=\"text-on-surface-variant font-medium\">Institución</span>\n<span class=\"font-bold text-on-surface text-sm\">Banco Pichincha</span>\n</div>\n<!-- Row: Account Type -->\n<div class=\"flex items-center justify-between py-2 border-b border-outline-variant/20 text-xs\">\n<span class=\"text-on-surface-variant font-medium\">Tipo de cuenta</span>\n<span class=\"font-semibold text-on-surface\">Cuenta Corriente</span>\n</div>\n<!-- Row: Account Number (High Visibility) -->\n<div class=\"flex items-center justify-between py-2 border-b border-outline-variant/20\">\n<div>\n<span class=\"text-[11px] text-on-surface-variant block\">Número de cuenta</span>\n<span class=\"font-headline font-bold text-base tracking-wider text-on-surface\" id=\"accountNum\">2100876543</span>\n</div>\n<button class=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-primary-container text-on-primary-container hover:brightness-95 transition-all text-xs font-bold shadow-sm\" id=\"btnCopyAccount\" onclick=\"copyToClipboard('2100876543', 'btnCopyAccountText', 'btnCopyAccountIcon')\">\n<span class=\"material-symbols-outlined text-[16px]\" id=\"btnCopyAccountIcon\">content_copy</span>\n<span id=\"btnCopyAccountText\">Copiar</span>\n</button>\n</div>\n<!-- Row: Beneficiary -->\n<div class=\"flex items-center justify-between py-2 border-b border-outline-variant/20 text-xs\">\n<span class=\"text-on-surface-variant font-medium\">Beneficiario</span>\n<span class=\"font-bold text-on-surface\">Wasi Granel S.A.S.</span>\n</div>\n<!-- Row: RUC with Copy -->\n<div class=\"flex items-center justify-between py-2 border-b border-outline-variant/20 text-xs\">\n<span class=\"text-on-surface-variant font-medium\">RUC / C.I.</span>\n<div class=\"flex items-center gap-2\">\n<span class=\"font-bold text-on-surface font-mono text-[13px]\">1793148201001</span>\n<button class=\"p-1 rounded hover:bg-surface-container text-on-surface-variant transition-colors\" id=\"btnCopyRuc\" onclick=\"copyToClipboard('1793148201001', 'btnCopyRucText', 'btnCopyRucIcon')\" title=\"Copiar RUC\">\n<span class=\"material-symbols-outlined text-[16px]\" id=\"btnCopyRucIcon\">content_copy</span>\n<span class=\"sr-only\" id=\"btnCopyRucText\">Copiar</span>\n</button>\n</div>\n</div>\n<!-- Row: Email for Receipts -->\n<div class=\"flex items-center justify-between py-2 text-xs\">\n<span class=\"text-on-surface-variant font-medium\">Correo notificaciones</span>\n<div class=\"flex items-center gap-2\">\n<span class=\"font-semibold text-on-surface\">pagos@wasigranel.com</span>\n<button class=\"p-1 rounded hover:bg-surface-container text-on-surface-variant transition-colors\" id=\"btnCopyEmail\" onclick=\"copyToClipboard('pagos@wasigranel.com', 'btnCopyEmailText', 'btnCopyEmailIcon')\" title=\"Copiar correo\">\n<span class=\"material-symbols-outlined text-[16px]\" id=\"btnCopyEmailIcon\">content_copy</span>\n<span class=\"sr-only\" id=\"btnCopyEmailText\">Copiar</span>\n</button>\n</div>\n</div>\n</div>\n<div class=\"p-3 rounded-lg bg-surface-container/60 text-[12px] text-on-surface-variant leading-relaxed\">\n<span class=\"font-bold text-on-surface\">Aviso de acreditación:</span> Pichincha directo confirma de inmediato. Transferencias desde otros bancos (Produbanco, Guayaquil, Pacífico) toman de 2 a 4 horas hábiles.\n          </div>\n</div>\n<div class=\"pt-6 mt-6 border-t border-outline-variant/20 flex items-center justify-between text-xs text-on-surface-variant font-medium\">\n<span>Costo de transferencia:</span>\n<span class=\"font-bold text-on-surface\">$0.00 (sin cargos Wasi)</span>\n</div>\n</div>\n</div>\n<!-- Bottom Confirmation Callout (WhatsApp Dispatch Link) -->\n<div class=\"w-full bg-surface-container rounded-2xl p-6 sm:p-8 flex flex-col md:flex-row items-center justify-between gap-6 relative shadow-sm\">\n<div class=\"flex items-start sm:items-center gap-4\">\n<div class=\"w-14 h-14 rounded-2xl bg-surface-container-lowest flex items-center justify-center shrink-0 shadow-sm text-primary\">\n<span class=\"material-symbols-outlined text-[32px]\">chat</span>\n</div>\n<div class=\"space-y-1\">\n<h3 class=\"font-headline font-bold text-lg text-on-surface\">\n            ¿Ya realizaste tu pago?\n          </h3>\n<p class=\"text-sm text-on-surface-variant max-w-xl leading-relaxed\">\n            Envíanos una captura o comprobante en formato digital indicando el código <span class=\"font-bold text-on-surface\">WG-2026-0001</span>. Comenzaremos el pesaje y etiquetado biodegradable al instante.\n          </p>\n<div class=\"flex items-center gap-2 pt-1 text-[11px] text-on-surface-variant font-medium\">\n<span class=\"material-symbols-outlined text-[14px]\">schedule</span>\n<span>Atención y validación continua: Lunes a Sábado de 08:00 a 19:00</span>\n</div>\n</div>\n</div>\n<div class=\"shrink-0 w-full md:w-auto\">\n<a class=\"w-full md:w-auto inline-flex items-center justify-center gap-3 px-6 py-4 rounded-xl bg-primary-container text-on-primary-container hover:brightness-95 active:scale-[0.99] font-headline font-bold text-sm shadow-md transition-all tracking-tight\" href=\"https://wa.me/593990876620?text=Hola%20Wasi%20Granel%2C%20adjunto%20el%20comprobante%20de%20mi%20pedido%20WG-2026-0001\" rel=\"noopener noreferrer\" target=\"_blank\">\n<span class=\"material-symbols-outlined text-[20px]\">send</span>\n<span>Enviar comprobante por WhatsApp (099 087 6620)</span>\n</a>\n</div>\n</div>\n<!-- Assurance Badges Grid -->\n<div class=\"grid grid-cols-1 sm:grid-cols-3 gap-4 pt-10 text-center\">\n<div class=\"p-4 rounded-xl bg-surface-container-low flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-primary text-[24px]\">eco</span>\n<div class=\"text-left\">\n<p class=\"font-bold text-xs text-on-surface\">Empaque Zero-Waste</p>\n<p class=\"text-[11px] text-on-surface-variant\">Frascos retornables y papel kraft</p>\n</div>\n</div>\n<div class=\"p-4 rounded-xl bg-surface-container-low flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-primary text-[24px]\">scale</span>\n<div class=\"text-left\">\n<p class=\"font-bold text-xs text-on-surface\">Pesado Certificado</p>\n<p class=\"text-[11px] text-on-surface-variant\">Gramaje preciso y controlado</p>\n</div>\n</div>\n<div class=\"p-4 rounded-xl bg-surface-container-low flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-primary text-[24px]\">local_shipping</span>\n<div class=\"text-left\">\n<p class=\"font-bold text-xs text-on-surface\">Despacho Urbano</p>\n<p class=\"text-[11px] text-on-surface-variant\">Riobamba &amp; Distrito Metropolitano Quito</p>\n</div>\n</div>\n</div>\n</div>\n<!-- Toast Notification element -->\n<div class=\"fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 pointer-events-none transition-all duration-300 ease-out bg-inverse-surface text-inverse-on-surface px-4 py-3 rounded-lg shadow-xl flex items-center gap-3 text-xs font-semibold\" id=\"copyToast\">\n<span class=\"material-symbols-outlined text-primary-container text-[18px]\">check_circle</span>\n<span id=\"toastMsg\">Copiado al portapapeles</span>\n</div>\n</div>\n<script>\n  function copyToClipboard(text, textElementId, iconElementId) {\n    if (navigator.clipboard && window.isSecureContext) {\n      navigator.clipboard.writeText(text).then(showSuccessFeedback).catch(fallbackCopy);\n    } else {\n      fallbackCopy();\n    }\n\n    function fallbackCopy() {\n      const textarea = document.createElement(\"textarea\");\n      textarea.value = text;\n      textarea.style.position = \"fixed\";\n      textarea.style.opacity = \"0\";\n      document.body.appendChild(textarea);\n      textarea.focus();\n      textarea.select();\n      try {\n        document.execCommand('copy');\n        showSuccessFeedback();\n      } catch (err) {\n        console.error('No se pudo copiar el texto', err);\n      }\n      document.body.removeChild(textarea);\n    }\n\n    function showSuccessFeedback() {\n      const textElem = document.getElementById(textElementId);\n      const iconElem = document.getElementById(iconElementId);\n      const toast = document.getElementById('copyToast');\n      const toastMsg = document.getElementById('toastMsg');\n\n      const originalText = textElem ? textElem.textContent : '';\n      const originalIcon = iconElem ? iconElem.textContent : '';\n\n      if (textElem && textElementId !== 'btnCopyRucText' && textElementId !== 'btnCopyEmailText') {\n        textElem.textContent = '¡Copiado!';\n      }\n      if (iconElem) {\n        iconElem.textContent = 'check';\n      }\n\n      if (toast && toastMsg) {\n        toastMsg.textContent = 'Copiado: ' + text;\n        toast.classList.remove('translate-y-20', 'opacity-0');\n        toast.classList.add('translate-y-0', 'opacity-100');\n\n        setTimeout(() => {\n          toast.classList.add('translate-y-20', 'opacity-0');\n          toast.classList.remove('translate-y-0', 'opacity-100');\n        }, 2400);\n      }\n\n      setTimeout(() => {\n        if (textElem) textElem.textContent = originalText;\n        if (iconElem) iconElem.textContent = originalIcon;\n      }, 2000);\n    }\n  }\n</script></main><footer class=\"w-full bg-primary-container text-on-primary-container mt-auto\"><div class=\"max-w-7xl mx-auto px-6 lg:px-12 pt-16 pb-12\"><div class=\"grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-on-primary-container/20\"><div class=\"space-y-4\"><div class=\"flex items-center gap-3\"><img alt=\"logo.png\" class=\"h-8 w-auto object-contain brightness-0\" src=\"https://lh3.googleusercontent.com/aida/AEtjO1Un6K08koTes3j5eZfEV67pnSVVJ9hGHpglLARgFBwlcSa_JCLiPmXUcbfl4_0-xFXZ29nlpMZTky_9ch6cu_lORIIcG6XXzkd21VVqUrhPeck-Nbh00OEg8uVYTvgUcTGui_sLnAGWqjkTIl1i2JhnH1DfmfJ5RLihndd7HYModi_09fDuEYSNBOVVF7oaqmj3h8iu4pASCtnMVMsNR4Ww2QDf1OvyPwaZYTk9S6NRWWBhechBiA