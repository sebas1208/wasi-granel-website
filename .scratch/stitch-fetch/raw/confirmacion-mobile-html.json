{
  "html": "<!DOCTYPE html>\n\n<html lang=\"en\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\" name=\"viewport\"/><meta content=\"mobile_stack\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/><link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/><link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&amp;display=swap\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><style>@layer base{html,body{width:100vw;margin:0;padding:0;}body{overscroll-behavior:none;}.pb-safe{padding-bottom:env(safe-area-inset-bottom,0px);}.pt-safe{padding-top:env(safe-area-inset-top,0px);}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config = { darkMode: \"class\", theme: { extend: { colors: { \"surface\": \"#fff8f4\", \"secondary-container\": \"#f5dece\", \"primary\": \"#785a00\", \"surface-dim\": \"#ead7c3\", \"tertiary\": \"#695c50\", \"secondary\": \"#6c5b4f\", \"on-secondary-fixed\": \"#251910\", \"error-container\": \"#ffdad6\", \"surface-container-low\": \"#fff1e5\", \"on-primary-container\": \"#6b4f00\", \"secondary-fixed\": \"#f5dece\", \"surface-tint\": \"#785a00\", \"on-tertiary-fixed\": \"#231a11\", \"inverse-primary\": \"#fabd00\", \"on-background\": \"#241a0d\", \"surface-container-highest\": \"#f3dfcb\", \"tertiary-container\": \"#d7c6b7\", \"inverse-surface\": \"#3a2e21\", \"on-primary\": \"#ffffff\", \"on-secondary-fixed-variant\": \"#534438\", \"on-tertiary\": \"#ffffff\", \"on-error-container\": \"#93000a\", \"tertiary-fixed\": \"#f1dfd0\", \"on-secondary\": \"#ffffff\", \"on-primary-fixed\": \"#251a00\", \"primary-fixed\": \"#ffdf9d\", \"on-surface-variant\": \"#4f4632\", \"on-error\": \"#ffffff\", \"secondary-fixed-dim\": \"#d8c3b3\", \"surface-container-high\": \"#f9e5d0\", \"on-secondary-container\": \"#726155\", \"primary-fixed-dim\": \"#fabd00\", \"on-tertiary-fixed-variant\": \"#50453a\", \"tertiary-fixed-dim\": \"#d4c4b5\", \"surface-container\": \"#ffebd6\", \"surface-container-lowest\": \"#ffffff\", \"on-primary-fixed-variant\": \"#5b4300\", \"on-tertiary-container\": \"#5e5246\", \"surface-variant\": \"#f3dfcb\", \"on-surface\": \"#241a0d\", \"error\": \"#ba1a1a\", \"outline\": \"#817660\", \"surface-bright\": \"#fff8f4\", \"outline-variant\": \"#d3c5ab\", \"inverse-on-surface\": \"#ffeedd\", \"background\": \"#fff8f4\", \"primary-container\": \"#fcbf00\" }, borderRadius: { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" }, spacing: {}, fontFamily: { \"headline\": [\"Plus Jakarta Sans\"], \"display\": [\"Plus Jakarta Sans\"], \"body\": [\"Plus Jakarta Sans\"], \"label\": [\"Plus Jakarta Sans\"] }, fontSize: {} } } }</script><style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head><body class=\"bg-surface font-body text-on-surface flex flex-col min-h-screen\"><header class=\"fixed top-0 w-full z-50 pt-safe bg-surface/80 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]\"><div class=\"h-16 px-4 flex items-center justify-between\"><div class=\"flex items-center gap-3\"><button aria-label=\"Go back\" class=\"min-w-[44px] min-h-[44px] flex items-center justify-center rounded-full text-on-surface hover:bg-surface-container-high/60 transition-colors\" onclick=\"history.back()\"><span class=\"material-symbols-outlined text-[22px]\">arrow_back</span></button><img alt=\"logo.png\" class=\"h-8 w-auto object-contain\" src=\"https://lh3.googleusercontent.com/aida/AEtjO1Un6K08koTes3j5eZfEV67pnSVVJ9hGHpglLARgFBwlcSa_JCLiPmXUcbfl4_0-xFXZ29nlpMZTky_9ch6cu_lORIIcG6XXzkd21VVqUrhPeck-Nbh00OEg8uVYTvgUcTGui_sLnAGWqjkTIl1i2JhnH1DfmfJ5RLihndd7HYModi_09fDuEYSNBOVVF7oaqmj3h8iu4pASCtnMVMsNR4Ww2QDf1OvyPwaZYTk9S6NRWWBhechBiA7pFGrDZRMCs5oAEaWItWPWVpA\"/><div class=\"flex flex-col\"><span class=\"text-[11px] font-label font-bold uppercase tracking-wider text-on-surface-variant leading-none\">Wasi Granel</span><h1 class=\"text-sm font-headline font-bold text-on-surface leading-tight\">Order Confirmation</h1></div></div><div class=\"flex items-center gap-2\"><div class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center\"><span class=\"material-symbols-outlined text-on-primary text-[18px]\">person</span></div></div></div></header><main class=\"flex flex-col relative w-full pt-16 pb-safe bg-surface min-h-screen\"><div class=\"flex flex-col w-full px-4 pb-12\">\n<!-- Subtle Andean Geometry Ambient Watermark -->\n<div class=\"relative w-full flex flex-col items-center pt-4\">\n<!-- Visual Accent Element (Soft Ambient Glow Behind Checkmark) -->\n<div class=\"relative flex items-center justify-center my-3\">\n<div class=\"absolute w-28 h-28 rounded-full bg-primary-container/25 blur-2xl pointer-events-none\"></div>\n<div class=\"relative w-20 h-20 rounded-full bg-primary-container shadow-lg shadow-on-surface/5 flex items-center justify-center transition-transform active:scale-95 duration-200\">\n<span class=\"material-symbols-outlined text-on-surface text-[40px] font-bold\" style=\"font-variation-settings: 'FILL' 1, 'wght' 700;\">check</span>\n</div>\n</div>\n<!-- Eyebrow Pill -->\n<div class=\"inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-secondary-container text-on-secondary-container mt-2\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-primary\"></span>\n<span class=\"text-[11px] font-label font-bold tracking-widest uppercase\">Pedido Confirmado</span>\n</div>\n<!-- Heading -->\n<h1 class=\"text-2xl font-headline font-bold text-on-surface text-center mt-3 tracking-tight\">\n      ¡Gracias, Camila!\n    </h1>\n<!-- Reassurance Copy -->\n<p class=\"text-sm font-body text-tertiary text-center mt-2.5 max-w-sm leading-relaxed\">\n      Hemos recibido tu solicitud correctamente. No es necesario realizar ningún pago por ahora: verificaremos las existencias y pesaremos cada producto con precisión artesanal antes de coordinar contigo.\n    </p>\n<!-- Visual Storytelling Accent Card: Artisanal Bulk Weighing -->\n<div class=\"w-full mt-6 rounded-xl overflow-hidden shadow-sm bg-surface-container-low\">\n<div class=\"relative h-32 w-full\">\n<img class=\"w-full h-full object-cover\" data-alt=\"Close up aesthetic shot of brass balance scale weighing organic quinoa and dried grains in cotton linen pouches, warm natural diffused sunlight, warm earthy tones with ochre and deep brown accents, clean minimalist modern bulk store in Andean Ecuador, zero-waste aesthetic.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBv3Ms_FvY_D7VU_3f1pxMGg2pj3-Od_CcwWaE1NYWQyqDjewqhOFo361oIDCq1yYezzZFfSOQtyzdrjUxlmQYA1P5Q4VUZibW_4M9tELOJbrQ7K05Q4vF-_hbLBcA53YtAvZcIMVXgi2Ye4C6ny0BkSfnK5k4Y5_cU4hV-JfAmoZqDLUZUocxCT_1brTAwwJRrKtdH_MEluvMYsH8fu4X40tBK5W6ma_nXrXxxPYMQ\"/>\n<div class=\"absolute inset-0 bg-gradient-to-t from-on-surface/60 via-transparent to-transparent flex items-end p-3\">\n<div class=\"flex items-center gap-2 text-surface\">\n<span class=\"material-symbols-outlined text-[18px]\">scale</span>\n<span class=\"text-xs font-label font-medium tracking-wide\">Preparación a granel libre de plástico</span>\n</div>\n</div>\n</div>\n</div>\n<!-- Order Reference Card -->\n<div class=\"w-full mt-4 p-4 rounded-xl bg-surface-container-low shadow-sm flex flex-col gap-2\">\n<span class=\"text-[11px] font-label font-bold uppercase tracking-wider text-tertiary\">\n        Tu número de pedido\n      </span>\n<div class=\"flex items-center justify-between gap-2\">\n<span class=\"text-xl font-headline font-bold tracking-wider text-on-surface\" id=\"orderNumber\">\n          WG-2026-0001\n        </span>\n<button aria-label=\"Copiar número de pedido\" class=\"min-h-[48px] px-4 py-2 rounded-lg bg-surface-container-high active:bg-secondary-container flex items-center gap-2 text-on-surface transition-all select-none\" id=\"copyBtn\" onclick=\"copyOrderCode()\">\n<span class=\"material-symbols-outlined text-[18px]\" id=\"copyIcon\">content_copy</span>\n<span class=\"text-xs font-label font-bold uppercase tracking-wider\" id=\"copyText\">Copiar</span>\n</button>\n</div>\n<!-- Toast feedback container -->\n<div class=\"h-0 opacity-0 overflow-hidden transition-all duration-300 text-xs font-body font-medium text-primary flex items-center gap-1\" id=\"copyFeedback\">\n<span class=\"material-symbols-outlined text-[16px]\">check_circle</span>\n<span>¡Código copiado al portapapeles!</span>\n</div>\n</div>\n<!-- Direct Contact WhatsApp Priority Card -->\n<div class=\"w-full mt-4 p-5 rounded-xl bg-surface-container shadow-sm flex flex-col\">\n<div class=\"flex items-center gap-2.5\">\n<div class=\"w-8 h-8 rounded-full bg-primary-container flex items-center justify-center shrink-0\">\n<span class=\"material-symbols-outlined text-on-surface text-[18px]\">chat</span>\n</div>\n<h2 class=\"text-base font-headline font-bold text-on-surface\">\n          ¿Prefieres escribirnos tú?\n        </h2>\n</div>\n<p class=\"text-xs font-body text-tertiary mt-2.5 leading-relaxed\">\n        Si estás con poco tiempo o necesitas añadir algo de última hora, no tienes que esperar a que te contactemos.\n      </p>\n<!-- WhatsApp Main Action CTA -->\n<a class=\"mt-4 min-h-[50px] w-full rounded-lg bg-primary-container text-on-surface font-headline font-bold text-sm tracking-wide flex items-center justify-center gap-2.5 shadow-sm active:scale-[0.99] transition-transform select-none\" href=\"https://wa.me/593990876620?text=Hola%20Wasi%20Granel%2C%20quisiera%20consultar%20sobre%20mi%20pedido%20WG-2026-0001\" rel=\"noopener noreferrer\" target=\"_blank\">\n<span class=\"material-symbols-outlined text-[20px]\" style=\"font-variation-settings: 'FILL' 1;\">forum</span>\n<span>WhatsApp 099 087 6620</span>\n</a>\n<!-- Secondary Email -->\n<a class=\"mt-3 min-h-[44px] flex items-center justify-center gap-2 text-xs font-label font-semibold text-secondary hover:text-on-surface transition-colors\" href=\"mailto:info@wasigranel.com?subject=Pedido%20WG-2026-0001\">\n<span class=\"material-symbols-outlined text-[16px]\">mail</span>\n<span>info@wasigranel.com</span>\n</a>\n<!-- Store Hours -->\n<div class=\"mt-3 pt-3 flex items-start gap-2 text-tertiary\">\n<span class=\"material-symbols-outlined text-[16px] shrink-0 mt-0.5\">schedule</span>\n<div class=\"flex flex-col text-[11px] font-body leading-tight\">\n<span class=\"font-semibold text-on-surface\">Horarios de atención:</span>\n<span>Lunes a Sábado: 8:00 – 19:00</span>\n<span>Domingos: cerrado</span>\n</div>\n</div>\n</div>\n<!-- Numbered Steps Card (\"Qué pasa ahora\") -->\n<div class=\"w-full mt-4 p-5 rounded-xl bg-surface-container-low shadow-sm flex flex-col\">\n<div class=\"flex items-center gap-2 mb-4\">\n<span class=\"material-symbols-outlined text-primary text-[20px]\">timeline</span>\n<h2 class=\"text-sm font-headline font-bold text-on-surface uppercase tracking-wider\">\n          Qué pasa ahora\n        </h2>\n</div>\n<div class=\"flex flex-col gap-4\">\n<!-- Step 1 -->\n<div class=\"flex items-start gap-3.5\">\n<div class=\"w-7 h-7 rounded-full bg-secondary-container text-on-secondary-container font-headline font-bold text-xs flex items-center justify-center shrink-0 mt-0.5\">\n            1\n          </div>\n<div class=\"flex flex-col min-w-0\">\n<h3 class=\"text-xs font-headline font-bold text-on-surface\">\n              Confirmación del pesaje\n            </h3>\n<p class=\"text-xs font-body text-tertiary mt-0.5 leading-relaxed\">\n              Te escribimos por WhatsApp para confirmar el peso exacto, el envío y el total final.\n            </p>\n</div>\n</div>\n<!-- Step 2 -->\n<div class=\"flex items-start gap-3.5\">\n<div class=\"w-7 h-7 rounded-full bg-secondary-container text-on-secondary-container font-headline font-bold text-xs flex items-center justify-center shrink-0 mt-0.5\">\n            2\n          </div>\n<div class=\"flex flex-col min-w-0\">\n<h3 class=\"text-xs font-headline font-bold text-on-surface\">\n              Método de pago preferido\n            </h3>\n<p class=\"text-xs font-body text-tertiary mt-0.5 leading-relaxed\">\n              Eliges cómo pagar: transferencia bancaria, DeUna, o pago contra entrega en Riobamba.\n            </p>\n</div>\n</div>\n<!-- Step 3 -->\n<div class=\"flex items-start gap-3.5\">\n<div class=\"w-7 h-7 rounded-full bg-secondary-container text-on-secondary-container font-headline font-bold text-xs flex items-center justify-center shrink-0 mt-0.5\">\n            3\n          </div>\n<div class=\"flex flex-col min-w-0\">\n<h3 class=\"text-xs font-headline font-bold text-on-surface\">\n              Entrega y despacho consciente\n            </h3>\n<p class=\"text-xs font-body text-tertiary mt-0.5 leading-relaxed\">\n              Despachamos tu pedido. En Riobamba la entrega es gratis; a otras ciudades va por Servientrega.\n            </p>\n</div>\n</div>\n</div>\n</div>\n<!-- Secondary Navigation Action -->\n<a class=\"mt-6 w-full min-h-[48px] rounded-lg bg-surface-container-high text-on-surface font-headline font-bold text-sm tracking-wide flex items-center justify-center gap-2 active:bg-secondary-container transition-colors select-none\" href=\"#\" onclick=\"window.history.back(); return false;\">\n<span class=\"material-symbols-outlined text-[18px]\">arrow_back</span>\n<span>Volver a la tienda</span>\n</a>\n<!-- Trust & Philosophy Microcopy Banner -->\n<div class=\"w-full mt-6 py-3 px-4 rounded-xl bg-surface-container-highest/60 flex items-center justify-center gap-2 text-center\">\n<span class=\"material-symbols-outlined text-primary text-[18px]\">eco</span>\n<span class=\"text-[10px] font-label font-bold tracking-widest uppercase text-tertiary\">\n        Zero Waste • Empaque Consciente y Compra al Peso Exacto\n      </span>\n</div>\n<!-- Andean Local Community Origin Footer -->\n<div class=\"mt-4 flex flex-col items-center text-center text-[11px] font-body text-outline\">\n<div class=\"flex items-center gap-1.5 text-on-surface-variant font-medium\">\n<span class=\"material-symbols-outlined text-[14px]\">location_on</span>\n<span>Riobamba &amp; Quito, Ecuador</span>\n</div>\n<p class=\"text-[10px] text-tertiary mt-1\">\n        Consumo responsable con identidad andina\n      </p>\n</div>\n</div>\n</div>\n<script>\n  function copyOrderCode() {\n    const textToCopy = 'WG-2026-0001';\n    navigator.clipboard.writeText(textToCopy).then(() => {\n      const copyBtn = document.getElementById('copyBtn');\n      const copyIcon = document.getElementById('copyIcon');\n      const copyText = document.getElementById('copyText');\n      const feedback = document.getElementById('copyFeedback');\n      \n      if (copyIcon && copyText && feedback) {\n        copyIcon.innerText = 'check';\n        copyText.innerText = 'Copiado';\n        feedback.classList.remove('h-0', 'opacity-0');\n        feedback.classList.add('h-5', 'opacity-100', 'mt-1');\n        \n        setTimeout(() => {\n          copyIcon.innerText = 'content_copy';\n          copyText.innerText = 'Copiar';\n          feedback.classList.add('h-0', 'opacity-0');\n          feedback.classList.remove('h-5', 'opacity-100', 'mt-1');\n        }, 2600);\n      }\n    }).catch(() => {\n      // Fallback in environments without clipboard permissions\n      const orderNumber = document.getElementById('orderNumber');\n      if (orderNumber) {\n        orderNumber.classList.add('scale-105');\n        setTimeout(() => orderNumber.classList.remove('scale-105'), 300);\n      }\n    });\n  }\n</script></main></body></html>"
}
