  "html": "<!DOCTYPE html>\n\n<html lang=\"es\"><head><meta charset=\"utf-8\"/><meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/><meta content=\"web_standard\" name=\"shell-type\"/><link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&amp;display=swap\" rel=\"stylesheet\"/><link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/><style>@layer base{html,body{margin:0;padding:0;}body{overscroll-behavior:none;}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><script src=\"https://cdn.tailwindcss.com\"></script><script id=\"tailwind-config\">tailwind.config={darkMode:\"class\",theme:{extend:{colors:{\"primary-container\":\"#fcbf00\",\"inverse-on-surface\":\"#ffeedd\",\"outline-variant\":\"#d3c5ab\",\"on-surface-variant\":\"#4f4632\",\"inverse-surface\":\"#3a2e21\",\"tertiary\":\"#695c50\",\"error\":\"#ba1a1a\",\"surface-container-lowest\":\"#ffffff\",\"on-tertiary-fixed-variant\":\"#50453a\",\"surface-container-highest\":\"#f3dfcb\",\"on-secondary-container\":\"#726155\",\"surface-container-low\":\"#fff1e5\",\"on-secondary-fixed-variant\":\"#534438\",\"surface-variant\":\"#f3dfcb\",\"on-background\":\"#241a0d\",\"on-secondary-fixed\":\"#251910\",\"surface\":\"#fff8f4\",\"on-error-container\":\"#93000a\",\"surface-dim\":\"#ead7c3\",\"surface-tint\":\"#785a00\",\"on-error\":\"#ffffff\",\"on-surface\":\"#241a0d\",\"tertiary-container\":\"#d7c6b7\",\"primary-fixed\":\"#ffdf9d\",\"tertiary-fixed\":\"#f1dfd0\",\"primary\":\"#785a00\",\"on-primary\":\"#ffffff\",\"outline\":\"#817660\",\"on-tertiary-fixed\":\"#231a11\",\"on-primary-fixed\":\"#251a00\",\"secondary-container\":\"#f5dece\",\"on-tertiary\":\"#ffffff\",\"on-secondary\":\"#ffffff\",\"secondary-fixed-dim\":\"#d8c3b3\",\"on-primary-fixed-variant\":\"#5b4300\",\"secondary\":\"#6c5b4f\",\"surface-container-high\":\"#f9e5d0\",\"on-tertiary-container\":\"#5e5246\",\"inverse-primary\":\"#fabd00\",\"surface-bright\":\"#fff8f4\",\"on-primary-container\":\"#6b4f00\",\"primary-fixed-dim\":\"#fabd00\",\"tertiary-fixed-dim\":\"#d4c4b5\",\"secondary-fixed\":\"#f5dece\",\"background\":\"#fff8f4\",\"surface-container\":\"#ffebd6\",\"error-container\":\"#ffdad6\"},borderRadius:{\"DEFAULT\":\"0.25rem\",\"lg\":\"0.5rem\",\"xl\":\"0.75rem\",\"full\":\"9999px\"},spacing:{},fontFamily:{headline:[\"Plus Jakarta Sans\"],display:[\"Plus Jakarta Sans\"],body:[\"Plus Jakarta Sans\"],label:[\"Plus Jakarta Sans\"]},fontSize:{}}}};</script></head><body class=\"bg-surface font-body text-on-surface min-h-screen flex flex-col\"><header class=\"fixed top-0 left-0 right-0 z-50 bg-surface/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]\"><div class=\"h-20 max-w-7xl mx-auto px-6 lg:px-12 flex items-center justify-between gap-8\"><div class=\"flex items-center gap-3 shrink-0\"><img alt=\"logo.png\" class=\"h-8 w-auto object-contain\" src=\"https://lh3.googleusercontent.com/aida/AEtjO1Un6K08koTes3j5eZfEV67pnSVVJ9hGHpglLARgFBwlcSa_JCLiPmXUcbfl4_0-xFXZ29nlpMZTky_9ch6cu_lORIIcG6XXzkd21VVqUrhPeck-Nbh00OEg8uVYTvgUcTGui_sLnAGWqjkTIl1i2JhnH1DfmfJ5RLihndd7HYModi_09fDuEYSNBOVVF7oaqmj3h8iu4pASCtnMVMsNR4Ww2QDf1OvyPwaZYTk9S6NRWWBhechBiA7pFGrDZRMCs5oAEaWItWPWVpA\"/><span class=\"font-headline font-bold text-xl tracking-tight text-on-surface\">Wasi Granel</span></div><nav class=\"hidden md:flex items-center gap-8\" data-active-classes=\"text-on-surface font-bold\"><a class=\"text-sm text-on-surface-variant hover:text-on-surface transition-colors font-medium\" data-path=\"inicio\" href=\"#\">Inicio</a><a class=\"text-sm text-on-surface-variant hover:text-on-surface transition-colors font-medium\" data-path=\"tienda\" href=\"#\">Tienda</a><a class=\"text-sm text-on-surface-variant hover:text-on-surface transition-colors font-medium\" data-path=\"contacto\" href=\"#\">Contacto</a></nav><div class=\"flex-1 max-w-md hidden sm:block\"><div class=\"relative flex items-center\"><span class=\"material-symbols-outlined absolute left-3.5 text-on-surface-variant text-[20px] pointer-events-none\">search</span><input class=\"w-full pl-10 pr-4 py-2 bg-surface-container-lowest text-on-surface placeholder:text-on-surface-variant text-sm rounded-lg border border-outline-variant focus:outline-none focus:border-on-surface transition-colors\" placeholder=\"Buscar...\" type=\"text\"/></div></div><div class=\"flex items-center gap-4 shrink-0\"><button aria-label=\"Ver carrito de compras\" class=\"relative p-2 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors\" type=\"button\"><span class=\"material-symbols-outlined text-[24px]\">shopping_bag</span><span class=\"absolute top-1 right-1 flex items-center justify-center min-w-[18px] h-[18px] px-1 text-[11px] font-bold bg-primary text-on-primary rounded-full\">3</span></button><div class=\"w-8 h-8 rounded-full bg-primary flex items-center justify-center\"><span class=\"material-symbols-outlined text-on-primary text-[18px]\">person</span></div></div></div></header><main class=\"w-full flex-1 pt-20 bg-surface\"><div class=\"flex flex-col w-full\">\n<div class=\"w-full max-w-2xl mx-auto py-12 sm:py-16 px-4 sm:px-6\">\n<!-- Central Flow Layout -->\n<div class=\"flex flex-col items-center text-center space-y-6\">\n<!-- Brand Success Icon (Andean Stylized Checkmark Seal) -->\n<div class=\"relative flex items-center justify-center\">\n<div class=\"w-24 h-24 rounded-full bg-primary-container/20 flex items-center justify-center\">\n<div class=\"w-16 h-16 rounded-full bg-primary-container flex items-center justify-center shadow-sm\">\n<svg class=\"w-8 h-8 text-on-surface\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" viewbox=\"0 0 32 32\">\n<path d=\"M7 16.5L13 22.5L25 9.5\"></path>\n<circle cx=\"16\" cy=\"16\" r=\"14\" stroke-dasharray=\"3 3\" stroke-width=\"1.5\"></circle>\n</svg>\n</div>\n</div>\n</div>\n<!-- Eyebrow Badge -->\n<div>\n<span class=\"inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-bold tracking-widest uppercase bg-surface-container text-on-surface-variant\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-primary\"></span>\n          Pedido confirmado\n        </span>\n</div>\n<!-- Title & Reassuring Subhead -->\n<div class=\"space-y-3 max-w-lg\">\n<h1 class=\"text-3xl sm:text-4xl font-bold tracking-tight text-on-surface font-headline\">\n          ¡Gracias, Camila!\n        </h1>\n<p class=\"text-base text-on-surface-variant leading-relaxed\">\n          Hemos recibido tu solicitud correctamente. No es necesario realizar ningún pago por ahora: verificaremos las existencias y pesaremos cada producto con precisión artesanal antes de coordinar contigo.\n        </p>\n</div>\n<!-- Order Reference Card -->\n<div class=\"w-full bg-surface-container-low rounded-xl p-5 sm:p-6 text-left shadow-sm mt-2\">\n<div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n<div class=\"space-y-1\">\n<p class=\"text-xs uppercase font-bold tracking-wider text-on-surface-variant\">\n              Tu número de pedido\n            </p>\n<div class=\"flex items-center gap-2\">\n<span class=\"text-2xl sm:text-3xl font-bold tracking-tight text-on-surface font-mono\" id=\"orderNumber\">\n                WG-2026-0001\n              </span>\n</div>\n</div>\n<button aria-label=\"Copiar número de pedido\" class=\"inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-medium text-sm transition-colors self-start sm:self-center focus:outline-none\" id=\"copyBtn\" onclick=\"copyOrderRef()\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\" id=\"copyIcon\">content_copy</span>\n<span id=\"copyText\">Copiar</span>\n</button>\n</div>\n</div>\n<!-- Section: Qué pasa ahora (3 Steps) -->\n<div class=\"w-full text-left space-y-6 pt-6\">\n<h2 class=\"text-xl font-bold text-on-surface font-headline\">\n          Qué pasa ahora\n        </h2>\n<div class=\"space-y-4\">\n<!-- Step 1 -->\n<div class=\"flex items-start gap-4 p-4 rounded-xl bg-surface-container-lowest shadow-sm\">\n<div class=\"flex-shrink-0 w-8 h-8 rounded-full bg-primary-container text-on-surface flex items-center justify-center font-bold text-sm\">\n              1\n            </div>\n<div class=\"space-y-0.5 pt-0.5\">\n<p class=\"text-sm sm:text-base font-semibold text-on-surface\">Confirmación del pesaje</p>\n<p class=\"text-sm text-on-surface-variant leading-relaxed\">\n                Te escribimos por WhatsApp para confirmar el peso, el envío y el pago.\n              </p>\n</div>\n</div>\n<!-- Step 2 -->\n<div class=\"flex items-start gap-4 p-4 rounded-xl bg-surface-container-lowest shadow-sm\">\n<div class=\"flex-shrink-0 w-8 h-8 rounded-full bg-primary-container text-on-surface flex items-center justify-center font-bold text-sm\">\n              2\n            </div>\n<div class=\"space-y-0.5 pt-0.5\">\n<p class=\"text-sm sm:text-base font-semibold text-on-surface\">Método de pago preferido</p>\n<p class=\"text-sm text-on-surface-variant leading-relaxed\">\n                Eliges cómo pagar: transferencia, DeUna, o pago al recibir en Riobamba.\n              </p>\n</div>\n</div>\n<!-- Step 3 -->\n<div class=\"flex items-start gap-4 p-4 rounded-xl bg-surface-container-lowest shadow-sm\">\n<div class=\"flex-shrink-0 w-8 h-8 rounded-full bg-primary-container text-on-surface flex items-center justify-center font-bold text-sm\">\n              3\n            </div>\n<div class=\"space-y-0.5 pt-0.5\">\n<p class=\"text-sm sm:text-base font-semibold text-on-surface\">Entrega y despacho consciente</p>\n<p class=\"text-sm text-on-surface-variant leading-relaxed\">\n                Despachamos tu pedido. En Riobamba la entrega es gratis; a otras ciudades va por Servientrega.\n              </p>\n</div>\n</div>\n</div>\n</div>\n<!-- Direct Contact Card -->\n<div class=\"w-full bg-surface-container-low rounded-xl p-6 sm:p-7 text-left space-y-5 shadow-sm mt-4\">\n<div class=\"space-y-1\">\n<h3 class=\"text-lg font-bold text-on-surface font-headline\">\n            ¿Prefieres escribirnos tú?\n          </h3>\n<p class=\"text-sm text-on-surface-variant\">\n            Si estás con poco tiempo o necesitas añadir algo de última hora, no tienes que esperar a que te contactemos.\n          </p>\n</div>\n<div class=\"flex flex-col sm:flex-row gap-3 pt-1\">\n<!-- WhatsApp Contact Button -->\n<a class=\"flex-1 inline-flex items-center justify-center gap-2.5 px-5 py-3 rounded-lg bg-primary-container hover:brightness-95 text-on-surface font-bold text-sm transition-all shadow-sm\" href=\"https://wa.me/593990876620\" rel=\"noopener noreferrer\" target=\"_blank\">\n<span class=\"material-symbols-outlined text-[20px]\">chat</span>\n<span>WhatsApp 099 087 6620</span>\n</a>\n<!-- Email Link Button -->\n<a class=\"inline-flex items-center justify-center gap-2 px-4 py-3 rounded-lg bg-surface-container-highest hover:bg-surface-variant text-on-surface text-sm font-semibold transition-colors\" href=\"mailto:info@wasigranel.com\">\n<span class=\"material-symbols-outlined text-[20px]\">mail</span>\n<span>info@wasigranel.com</span>\n</a>\n</div>\n<!-- Operating Hours & Puruha Heritage Notice -->\n<div class=\"flex items-center gap-2.5 pt-2 text-xs text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[16px] text-primary shrink-0\">schedule</span>\n<span>Lunes a Sábado: 8:00 – 19:00, Domingos: cerrado</span>\n</div>\n</div>\n<!-- Secondary Navigation & Sustainability Footnote -->\n<div class=\"w-full pt-4 flex flex-col items-center space-y-6\">\n<a class=\"inline-flex items-center gap-2 px-6 py-2.5 rounded-lg text-sm font-semibold text-on-surface hover:bg-surface-container-low transition-colors\" href=\"#\">\n<span class=\"material-symbols-outlined text-[18px]\">arrow_back</span>\n<span>Volver a la tienda</span>\n</a>\n<div class=\"flex items-center gap-2 text-xs font-medium text-on-surface-variant/80 uppercase tracking-widest pt-2\">\n<span class=\"material-symbols-outlined text-[16px] text-primary\">eco</span>\n<span>Zero Waste • Empaque consciente y compra al peso exacto</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n<script>\n  function copyOrderRef() {\n    const text = document.getElementById('orderNumber').innerText.trim();\n    navigator.clipboard.writeText(text).then(() => {\n      const copyText = document.getElementById('copyText');\n      const copyIcon = document.getElementById('copyIcon');\n      \n      copyText.innerText = '¡Copiado!';\n      copyIcon.innerText = 'check';\n      \n      setTimeout(() => {\n        copyText.innerText = 'Copiar';\n        copyIcon.innerText = 'content_copy';\n      }, 2500);\n    }).catch(err => {\n      console.error('Error al copiar el código:', err);\n    });\n  }\n</script></main><footer class=\"w-full bg-primary-container text-on-primary-container mt-auto\"><div class=\"max-w-7xl mx-auto px-6 lg:px-12 pt-16 pb-12\"><div class=\"grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-on-primary-container/20\"><div class=\"space-y-4\"><div class=\"flex items-center gap-3\"><img alt=\"logo.png\" class=\"h-8 w-auto object-contain brightness-0\" src=\"https://lh3.googleusercontent.com/aida/AEtjO1Un6K08koTes3j5eZfEV67pnSVVJ9hGHpglLARgFBwlcSa_JCLiPmXUcbfl4_0-xFXZ29nlpMZTky_9ch6cu_lORIIcG6XXzkd21VVqUrhPeck-Nbh00OEg8uVYTvgUcTGui_sLnAGWqjkTIl1i2JhnH1DfmfJ5RLihndd7HYModi_09fDuEYSNBOVVF7oaqmj3h8iu4pASCtnMVMsNR4Ww2QDf1OvyPwaZYTk9S6NRWWBhechBiA7pFGrDZRMCs5oAEaWItWPWVpA\"/><span class=\"font-headline font-bold text-xl tracking-tight text-on-primary-container\">Wasi Granel</span></div><p class=\"text-sm text-on-primary-container leading-relaxed\">Consumo consciente, compras a granel y bienestar sostenible para tu hogar en armonía urbana.</p></div><div><h3 class=\"font-headline font-bold text-sm uppercase tracking-wider text-on-primary-container mb-4\">Navegación</h3><ul class=\"space-y-2.5 text-sm\"><li class=\"font-medium\"><a class=\"hover:underline\" href=\"#\">Inicio</a></li><li class=\"font-medium\"><a class=\"hover:underline\" href=\"#\">Tienda</a></li><li class=\"font-medium\"><a class=\"hover:underline\" href=\"#\">Granos y Semillas</a></li><li class=\"font-medium\"><a class=\"hover:underline\" href=\"#\">Contacto</a></li></ul></div><div><h3 class=\"font-headline font-bold text-sm uppercase tracking-wider text-on-primary-container mb-4\">Legal</h3><ul class=\"space-y-2.5 text-sm\"><li class=\"font-medium\"><a class=\"hover:underline\" href=\"#\">Términos y Condiciones</a></li><li class=\"font-medium\"><a class=\"hover:underline\" href=\"#\">Política de Privacidad</a></li><li class=\"font-medium\"><a class=\"hover:underline\" href=\"#\">Envíos y Devoluciones</a></li></ul></div><div><h3 class=\"font-headline font-bold text-sm uppercase tracking-wider text-on-primary-container mb-4\">Ubicación</h3><div class=\"space-y-3 text-sm\"><div class=\"flex items-start gap-2.5\"><span class=\"material-symbols-outlined text-[20px] shrink-0 mt-0.5\">location_on</span><span><strong>Riobamba:</strong> Centro Histórico &amp; Talleres Locales</span></div><div class=\"flex items-start gap-2.5\"><span class=\"material-symbols-outlined text-[20px] shrink-0 mt-0.5\">location_on</span><span><strong>Quito:</strong> Despachos Metropolitanos &amp; Puntos Aliados</span></div><div class=\"flex items-center gap-4 pt-2\"><a aria-label=\"Instagram\" class=\"p-1.5 rounded-full hover:bg-on-primary-container/10 transition-colors\" href=\"#\"><span class=\"material-symbols-outlined text-[20px]\">share</span></a><a aria-label=\"Email\" class=\"p-1.5 rounded-full hover:bg-on-primary-container/10 transition-colors\" href=\"#\"><span class=\"material-symbols-outlined text-[20px]\">mail</span></a></div></div></div></div><div class=\"pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-medium\"><p>© 2024 Wasi Granel. Dinamismo, orden y equilibrio cotidiano.</p><p class=\"text-on-primary-container/80\">Ecuador · Puruhá Heritage Concept</p></div></div></footer></body></html>"
